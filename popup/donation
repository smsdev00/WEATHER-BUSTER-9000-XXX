.donation-section {
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 2px dashed var(--border-glass);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.donation-text {
  font-family: var(--font-mono);
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: lowercase;
}

.donation-icons {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

/* Terrifying Rabbit with red glowing eyes */
.rabbit-icon {
  width: 28px;
  height: 28px;
  color: var(--text-secondary);
  position: relative;
}

.rabbit-icon svg {
  width: 100%;
  height: 100%;
}

/* Red glowing eyes effect */
.rabbit-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 75%;
  width: 4px;
  height: 4px;
  background: #ff0000;
  border-radius: 50%;
  filter: drop-shadow(0 0 6px #ff0000) drop-shadow(0 0 10px #ff0000);
  transform: translate(-50%, -100%);
  animation: eye-glow 2s ease-in-out infinite;
}

@keyframes eye-glow {
  0%, 100% { opacity: 1; filter: drop-shadow(0 0 6px #ff0000); }
  50% { opacity: 0.7; filter: drop-shadow(0 0 10px #ff0000) drop-shadow(0 0 15px #ff0000); }
}

/* Hand-coins with pulse animation */
.hand-coins-icon {
  width: 28px;
  height: 28px;
  color: var(--warning);
  cursor: pointer;
  transition: all var(--transition-fast);
  animation: pulse-glow 2s ease-in-out infinite;
}

.hand-coins-icon svg {
  width: 100%;
  height: 100%;
}

.hand-coins-icon:hover {
  transform: scale(1.15) rotate(-5deg);
  filter: drop-shadow(0 0 10px gold) drop-shadow(0 0 20px gold);
  animation: none;
}

@keyframes pulse-glow {
  0%, 100% {
    filter: drop-shadow(0 0 3px rgba(245, 158, 11, 0.4));
  }
  50% {
    filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.7));
  }
}

/* Bouncing arrow - points left at hand */
.bounce-arrow {
  width: 20px;
  height: 20px;
  color: var(--warning);
  animation: bounce-left 1s ease-in-out infinite;
}

.bounce-arrow svg {
  width: 100%;
  height: 100%;
}

@keyframes bounce-left {
  0%, 100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(-5px);
  }
}

/* Refresh button animation */
.icon-btn.refreshing svg {
  animation: spin 1s linear infinite;
}

/* Responsive adjustments */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
